<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Appcopier</RootNamespace>
    <AssemblyName>Appcopier</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <!--
      MANDATORY. src/Appcopier/Properties/AssemblyInfo.cs is downloaded as raw text from GitHub
      by the already-deployed v0.30.0 update checker (Helpers/DataHelper.cs URL_ASSEMBLY +
      CheckForUpdates), which string-parses [assembly: AssemblyFileVersion("x.y.z")] out of it.
      That file must stay at its exact path with its exact line format, so the SDK must not
      generate competing assembly attributes (which would also be CS0579 duplicate errors).
      Never set Version/AssemblyVersion/FileVersion/InformationalVersion here either: AssemblyInfo.cs
      is the single source of truth that both sides of the update check read, and a csproj-set version
      would create a second, silently diverging one.
    -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Platforms>AnyCPU</Platforms>
    <Deterministic>true</Deterministic>
    <!--
      Leave ApplicationHighDpiMode / ApplicationVisualStyles / ApplicationUseCompatibleTextRendering
      / ApplicationDefaultFont UNSET, and do not introduce ApplicationConfiguration.Initialize()
      in Program.cs: any of those would emit a competing config that silently flips DPI awareness
      from the System-aware mode declared in app.manifest to PerMonitorV2.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Appcopier.Core\Appcopier.Core.csproj" />
  </ItemGroup>

</Project>
